# =============================================================================
# SAP Datasphere & S/4HANA Reconciliation Agent Configuration Template
# Safe template: Place actual secrets in .env (never commit .env to version control)
# =============================================================================

# 1. SAP Datasphere Consumption OData / API Base URL
DATASPHERE_API_URL=https://<tenant-id>.<region>.datasphere.cloud.sap/api/v1/datasphere/consumption/relational
# SAP BTP / Datasphere OAuth 2.0 Token Endpoint
DATASPHERE_TOKEN_URL=https://<subaccount-subdomain>.authentication.<region>.hana.ondemand.com/oauth/token
# Optional authorization endpoint (inferred from TOKEN_URL if omitted)
DATASPHERE_AUTHORIZATION_URL=https://<subaccount-subdomain>.authentication.<region>.hana.ondemand.com/oauth/authorize

# 2. SAP Datasphere Spaces
# Modeling / Discovery space (e.g. RADH_S3X)
DATASPHERE_SPACE_ID=your-modeling-space-id
DATASPHERE_MODELING_SPACE=your-modeling-space-id
# Optional replication / source space (e.g. RAD_HDLF)
DATASPHERE_REPLICATION_SPACE=your-replication-space-id

# 3. SAP Datasphere CLI Settings
DATASPHERE_CLI_COMMAND=datasphere
DATASPHERE_CLI_ACCEPT=application/vnd.sap.datasphere.object.content+json

# 4. OAuth 2.0 Client Credentials (Provisioned in Datasphere / SAP BTP)
OAUTH_CLIENT_ID=sb-<client-id>
OAUTH_CLIENT_SECRET=your-oauth-client-secret-here

# 5. SAP Datasphere / HANA Cloud Direct SQL (Zero-Buffer Direct Execution)
HANA_HOST=your-hana-cloud-instance.hanacloud.ondemand.com
HANA_PORT=443
HANA_USER=your-db-user#schema
HANA_PASSWORD=your-hana-password
HANA_ENCRYPT=True
HANA_SSL_VALIDATE_CERT=False

# 6. SAP S/4HANA ADT (Eclipse ABAP Development Tools) Configuration
SAP_BASE_URL=https://your-s4hana-host:44301
SAP_USERNAME=your-abap-username
SAP_PASSWORD=your-abap-password
ADT_ROW_LIMIT=100

# 7. LLM Providers Configuration (Zero business row data sent to LLM)
# Set to anthropic, gemini, or openai to prefer that provider; auto tries configured providers.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# 8. Backend Server Settings
API_HOST=0.0.0.0
API_PORT=9050
